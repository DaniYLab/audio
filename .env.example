# StoryForge environment template.
# Copy to `.env` and fill in values. NEVER commit the real `.env`.
# All variables use the SF_ prefix with __ as nesting separator.

# --- General ---
SF__WORKSPACE_DIR=data/workspace
SF__LOG_LEVEL=INFO
SF__LOG_FORMAT=console            # console | json

# --- Download ---
# Accepting this flag acknowledges YouTube ToS risk. See docs/CONVENTIONS.md.
SF__DOWNLOAD__ACKNOWLEDGE_TOS_RISK=false

# --- Transcription ---
SF__TRANSCRIPTION__ENGINE=whisperx            # whisperx | assemblyai
SF__TRANSCRIPTION__MODEL=large-v3
SF__TRANSCRIPTION__LANGUAGE=vi
SF__TRANSCRIPTION__DEVICE=cuda                # cuda | cpu
SF__TRANSCRIPTION__COMPUTE_TYPE=float16       # float16 | int8
SF__TRANSCRIPTION__ASSEMBLYAI_API_KEY=

# --- LLM (story writing / analysis). OpenAI-compatible endpoint covers
#     OpenAI, GLM, DeepSeek, Gemini-compat gateways, local vLLM, ... ---
SF__LLM__BASE_URL=https://api.openai.com/v1
SF__LLM__API_KEY=
SF__LLM__WRITER_MODEL=gpt-4o
SF__LLM__REVIEWER_MODEL=gpt-4o-mini
SF__LLM__TIMEOUT_SECONDS=120

# --- Knowledge base ---
SF__KNOWLEDGE__STORE=qdrant                   # qdrant | memory | chroma(dev, removal pending)
SF__KNOWLEDGE__COLLECTION=storyforge_kb
SF__KNOWLEDGE__COLLECTION_PREFIX=storyforge_kb
SF__KNOWLEDGE__KB_DATA_DIR=data/kb            # alias tables live here per universe
SF__KNOWLEDGE__QDRANT_URL=http://localhost:6333
SF__KNOWLEDGE__QDRANT_API_KEY=
SF__KNOWLEDGE__QDRANT_TIMEOUT_SECONDS=30
SF__KNOWLEDGE__EMBEDDING__PROVIDER=openai     # openai | bge_m3_local
SF__KNOWLEDGE__EMBEDDING__MODEL=text-embedding-3-small
SF__KNOWLEDGE__EMBEDDING__BASE_URL=
SF__KNOWLEDGE__EMBEDDING__API_KEY=
SF__KNOWLEDGE__CHUNK_SIZE_TOKENS=600
SF__KNOWLEDGE__CHUNK_OVERLAP_TOKENS=90
# M2-V1: reranker is measured before it becomes a default (design v4 §6).
SF__KNOWLEDGE__RERANKER_ENABLED=false
SF__KNOWLEDGE__RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# M2-V2: 1 cheap LLM call per fresh source at ingest (opt-in, design v4 §3).
SF__KNOWLEDGE__EPISODE_SUMMARY_ENABLED=false

# --- TTS ---
SF__TTS__ENGINE=edge                          # edge | elevenlabs
SF__TTS__EDGE_VOICE=vi-VN-NamMinhNeural
SF__TTS__NORMALIZE_TEXT=true                  # M2-W1: expand digits/abbreviations before TTS
SF__TTS__ELEVENLABS_API_KEY=
SF__TTS__ELEVENLABS_VOICE_ID=

# --- Image generation ---
SF__IMAGING__PROVIDER=fal                     # fal | openai
SF__IMAGING__FAL_KEY=
SF__IMAGING__FAL_MODEL=fal-ai/flux/schnell
SF__IMAGING__OPENAI_MODEL=gpt-image-1
SF__IMAGING__WIDTH=1920
SF__IMAGING__HEIGHT=1080

# --- Video assembly ---
SF__VIDEO__FFMPEG_BIN=ffmpeg
SF__VIDEO__FFPROBE_BIN=ffprobe
SF__VIDEO__CRF=20
SF__VIDEO__PRESET=medium
SF__VIDEO__KEN_BURNS=true
SF__VIDEO__BURN_SUBTITLES=true
